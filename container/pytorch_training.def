Bootstrap: docker
From: python:3.12-slim

%post
    apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        ca-certificates \
        curl \
        git \
        libglib2.0-0 \
        libgomp1 \
        vim \
        less \
        && rm -rf /var/lib/apt/lists/*

    pip install --no-cache-dir --upgrade pip

    # PyTorch from the CUDA 12.6 index only. Explorer drivers support CUDA 12.x,
    # and the default torch on PyPI is a CUDA 13 build that fails on them.
    pip install --no-cache-dir torch==2.14.1 torchvision==0.29.1 \
        --index-url https://download.pytorch.org/whl/cu126

    # torch==2.14.1 is listed again so pip stops with an error instead of
    # replacing PyTorch if one of these packages asks for a newer version.
    pip install --no-cache-dir torch==2.14.1 \
        numpy pandas scipy scikit-learn matplotlib tqdm seaborn \
        h5py pyarrow zarr \
        accelerate transformers datasets safetensors optuna \
        pillow opencv-python-headless tensorboard ipykernel

    # Keep a record of the exact package versions inside the image
    pip freeze > /opt/pip-freeze.txt

%environment
    export PYTHONNOUSERSITE=1

%labels
    Name: HPC-ML-Base-for-Fall-2026-Training
    Maintainer: Northeastern University Research Computing
    PyTorch 2.14.1
    CUDA_Build cu126

%test
    python -c "import torch, cv2; assert torch.version.cuda == '12.6', torch.version.cuda; print('PyTorch', torch.__version__, 'and OpenCV loaded successfully.')"
